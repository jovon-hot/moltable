{
  "manifest_version": 3,
  "name": "Moltable Memory",
  "version": "1.0.0",
  "description": "Inject Moltable memory toolbar into AI chat pages (ChatGPT, Claude, Gemini, DeepSeek)",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "idle"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://chat.deepseek.com/*",
    "http://localhost:8642/*",
    "https://moltable.ai/*",
    "https://www.moltable.ai/*",
    "https://api.moltable.ai/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Moltable Memory",
    "default_icon": {
      "16": "icons/icon16.svg",
      "48": "icons/icon48.svg",
      "128": "icons/icon128.svg"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://chat.deepseek.com/*"
      ],
      "js": ["content.js"],
      "css": ["toolbar.css"],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  }
}
