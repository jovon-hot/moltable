# =============================================================================
# Moltable — Production Environment Configuration
# =============================================================================
# Deploy:  docker-compose -f docker-compose.yml up -d
# =============================================================================

# ── Server ─────────────────────────────────────────────────

# Port the API server listens on (default: 8000 inside Docker)
PORT=8000

# ── Database ────────────────────────────────────────────────

# PostgreSQL connection string (Docker Compose auto-configures this)
# Override if using external Supabase:
# DATABASE_URL=postgresql://user:pass@host:5432/moltable

# Supabase (if using Supabase instead of local PG)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── DID+VC Issuer ──────────────────────────────────────────

# Domain used for did:web resolution
MOLTABLE_DOMAIN=moltable.io

# Ed25519 hex seed (64 chars). Auto-generated on first start if not set.
# IMPORTANT: Set this in production and keep it secret!
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
MOLTABLE_ISSUER_KEY=

# ── LLM ────────────────────────────────────────────────────

# DeepSeek API Key (required for consult_persona / compare_personas)
DEEPSEEK_API_KEY=

# ── Security ────────────────────────────────────────────────

# Pepper for legacy API Key hashing (generate with python3 -c "import secrets; print(secrets.token_hex(32))")
API_KEY_PEPPER=

# ── CORS ────────────────────────────────────────────────────

# Comma-separated origins (no trailing slash)
ALLOWED_ORIGINS=https://moltable.io,https://app.moltable.io

# ── Frontend ────────────────────────────────────────────────

# API URL for the web frontend (Docker Compose auto-configures this)
NEXT_PUBLIC_API_URL=http://api:8000

# ── Optional: Stripe Billing ────────────────────────────────
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
