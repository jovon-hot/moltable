# =============================================================================
# Moltable — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
#
# PRODUCTION REQUIRED:
#   SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY (or SUPABASE_ANON_KEY),
#   DEEPSEEK_API_KEY, API_KEY_PEPPER, ALLOWED_ORIGINS,
#   ADMIN_JWT_SECRET, ADMIN_PASSWORD_PEPPER
#
# OPTIONAL:
#   PORT (default: 8700)
# =============================================================================

# ── Supabase (production required) ─────────────────────────
# Get these from your Supabase project dashboard > Settings > API
SUPABASE_URL=https://your-project.supabase.co
# Use service_role key for admin operations (bypasses RLS).
# For RLS enforcement with user-level isolation, use SUPABASE_ANON_KEY instead.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Alternative: SUPABASE_ANON_KEY=eyJ... (for RLS-enabled environments)
# SUPABASE_ANON_KEY=

# ── DeepSeek LLM (production required) ─────────────────────
# Get your API key from https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-......

# ── API Security (production required) ────────────────────
# A random string used as a pepper for hashing API keys.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
API_KEY_PEPPER=your-random-pepper-string-here

# ── CORS Origins (production required) ────────────────────
# Comma-separated list of allowed origins (no trailing slash).
# In production, replace with your domain(s), e.g.:
#   ALLOWED_ORIGINS=https://app.moltable.io,https://admin.moltable.io
ALLOWED_ORIGINS=http://localhost:8701,http://localhost:3000

# ── Admin Auth (production required) ─────────────────────
# One dedicated secret per purpose — no sharing across JWT / password /
# database. Generate each with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
#
# Signs admin/operator session JWTs. The server REFUSES TO BOOT
# (RuntimeError) if missing or shorter than 32 chars.
ADMIN_JWT_SECRET=your-32+-char-admin-jwt-secret
#
# Mixed into admin password hashes (PBKDF2). Also required (>= 32 chars) —
# the server refuses to boot without it.
ADMIN_PASSWORD_PEPPER=your-32+-char-admin-password-pepper
#
# The database key is SUPABASE_SERVICE_ROLE_KEY above — used for database
# access ONLY. It is never reused as a JWT secret or password pepper.

# ── Server (optional) ─────────────────────────────────────
# Port the server listens on (default: 8700)
# PORT=8700

# ── Sync (bidirectional, git-style) ───────────────────────
# Endpoints: POST /api/sync/push|pull|resolve|export|import
# No extra env vars required. Version columns are added to the
# memories/personas/projects tables automatically via schema.sql
# (Supabase) or repositories/schema_sqlite.sql (SQLite dev mode).
# In SQLite dev mode the DB file location is:
# MOLTABLE_DB_PATH=./moltable_dev.db
# All sync timestamps are stored in UTC.

# ── Quota Limits (optional) ───────────────────────────────
# Override default per-plan resource quotas. Unset or invalid values
# fall back to the defaults below.
# Naming: MOLTABLE_QUOTA_{PLAN}_{RESOURCE}
#   PLAN     ∈ FREE / PRO / TEAM
#   RESOURCE ∈ IDENTITIES / PERSONAS / MEMORIES / AGENTS / API_CALLS_PER_DAY
#
# Defaults:
#   free: 1 identity, 2 personas, 100 memories, 1 agent, 50 api/day
#   pro:  3 identities, 10 personas, 10,000 memories, 5 agents, 500 api/day
#   team: 10 identities, 999,999 personas, 50,000 memories, 999,999 agents, 2,000 api/day
#
# MOLTABLE_QUOTA_FREE_PERSONAS=2
# MOLTABLE_QUOTA_FREE_MEMORIES=100
# MOLTABLE_QUOTA_FREE_AGENTS=1
# MOLTABLE_QUOTA_PRO_PERSONAS=10
# MOLTABLE_QUOTA_PRO_MEMORIES=10000
# MOLTABLE_QUOTA_PRO_AGENTS=5

# ── Embedding Model (optional) ────────────────────────────
# Default: "all-MiniLM-L6-v2" (English-optimized, fast)
# For Chinese/multilingual support, use:
#   MOLTABLE_EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# MOLTABLE_EMBED_MODEL=all-MiniLM-L6-v2

# ── Issuer Key (DID+VC, production required) ────────────────
# Ed25519 hex seed for VC signing. Auto-generated on first start
# and persisted to .moltable_issuer_key. Set this in production
# to keep the same key across deployments.
# MOLTABLE_ISSUER_KEY=

# ── DID Domain (production required) ────────────────────────
# Your domain for did:web resolution.
# MOLTABLE_DOMAIN=moltable.io
# Get these from your Stripe Dashboard > Developers > API keys
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_xxx   # Stripe Price ID for Pro plan
# STRIPE_PRICE_TEAM=price_xxx  # Stripe Price ID for Team plan
