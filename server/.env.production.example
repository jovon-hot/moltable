# =============================================================================
# Moltable · Production Environment Variables
# =============================================================================
# 复制为 .env.production 并填入真实值。
# 此文件仅作模板参考，不含真实密钥。
#
# 部署平台对应：
#   Railway (后端) → server/.env 或 Railway Dashboard 变量
#   Vercel  (前端) → Vercel Dashboard 变量（仅 NEXT_PUBLIC_ 前缀）
# =============================================================================

# ── Supabase (必需) ────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# SUPABASE_ANON_KEY=eyJ...  (如果启用 RLS)

# ── LLM (可选，用于 Persona consult 等 AI 功能) ──────────
DEEPSEEK_API_KEY=sk-......

# ── API Security (必需) ───────────────────────────────────
# 生成: python3 -c "import secrets; print(secrets.token_hex(32))"
API_KEY_PEPPER=your-random-pepper-string-here

# ── CORS (必需) ──────────────────────────────────────────
# 逗号分隔，不含尾部斜杠
ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-domain.com

# ── DID+VC (必需) ────────────────────────────────────────
# 生成: python3 -c "from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey; print(Ed25519PrivateKey.generate().private_bytes_raw().hex())"
MOLTABLE_ISSUER_KEY=
# DID 域名：did:web:moltable.io
MOLTABLE_DOMAIN=moltable.io

# ── Stripe (可选) ────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_TEAM=price_xxx

# ── Server (可选) ─────────────────────────────────────────
# Railway 自动注入 PORT，无需手动设置
# PORT=8000
# MOLTABLE_EMBED_MODEL=all-MiniLM-L6-v2
